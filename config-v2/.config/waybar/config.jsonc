{
    "id": "bar-0",
    "name": "bar-niri",
    "layer": "top",
    "mode": "dock",
    "height": 32,
    "margin": 0,
    "margin-top": 6,

    "include": [
        "$HOME/.config/waybar/modules.jsonc"
    ],

    "modules-left": [
        "custom/launcher",
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "network",
        "custom/weather",
        "cpu",
        "memory",
        "pulseaudio",
        "tray",
        "inhibitor"
    ]
}
