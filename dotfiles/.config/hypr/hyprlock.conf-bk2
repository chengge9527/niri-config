
# ==========================================
# Hyprlock - Blur Screenshot Lock Screen
# ==========================================

$font = JetBrainsMono Nerd Font

general {
    hide_cursor = true
    grace = 0
    ignore_empty = true
    immediate_render = true
}

# Screenshot background with blur
background {
    monitor =
    path = screenshot

    blur_passes = 3
    blur_size = 8
    noise = 0.02
    contrast = 0.90
    brightness = 0.65
    vibrancy = 0.15
    vibrancy_darkness = 0.0
}

# Large clock
label {
    monitor =
    text = cmd[update:1000] date +"%H:%M"
    color = rgba(255, 255, 255, 1.0)
    font_size = 96
    font_family = $font
    font_weight = 700

    position = 0, 100
    halign = center
    valign = center
}

# Date
label {
    monitor =
    text = cmd[update:60000] date +"%A, %B %d"
    color = rgba(205, 214, 244, 0.95)
    font_size = 18
    font_family = $font

    position = 0, 25
    halign = center
    valign = center
}

# Password input field
input-field {
    monitor =

    size = 340, 60
    outline_thickness = 2

    dots_size = 0.25
    dots_spacing = 0.25
    dots_center = true

    outer_color = rgba(137, 180, 250, 0.95)
    inner_color = rgba(30, 30, 46, 0.75)
    font_color = rgba(255, 255, 255, 1.0)

    fade_on_empty = false
    fade_timeout = 1000

    placeholder_text = <span foreground="##cdd6f4"> 󰌾  Enter Password...</span>
    fail_text = <span foreground="##f38ba8">Authentication failed</span>
    fail_timeout = 2000

    rounding = 16

    shadow_passes = 2
    shadow_size = 4
    shadow_color = rgba(0, 0, 0, 0.35)

    position = 0, -40
    halign = center
    valign = center
}
