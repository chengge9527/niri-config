# BACKGROUND
background {
    monitor =
    path = screenshot
    blur_passes = 3             # 模糊圈数，数值越高越模糊（建议 2-4）
    blur_size = 10               # 模糊大小（建议 5-10）
    noise = 0.0117              # 增加微量噪点，打破色彩断层
    contrast = 0.8916           # 降低对比度
    brightness = 0.6172         # 降低亮度（变暗，让白字更明显）
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# GENERAL
general {
    screencopy_mode = 0
    hide_cursor = true
}

# Time
label {
    monitor =
    text = $TIME
    color = rgba(187, 154, 243, 0.9)
    # font_family = JetBrains Mono Nerd Font
    font_size = 65
    position = 0, 100
    shadow_passes = 3
    shadow_size = 5
    shadow_color = rgba(26, 27, 38, 0.9)
    halign = center
    valign = center
}

# INPUT FIELD
input-field {
    monitor =
    size = 300, 60
    outline_thickness = 2
    dots_size = 0.3 # Scale of input-field height, 0.2 - 0.8
    dots_spacing = 0.3 # Scale of dots' absolute size, 0.0 - 1.0
    dots_center = true
    outer_color = rgba(122, 162, 247, 0.8)
    inner_color = rgba(26, 27, 38, 0.6)
    font_color = rgb(192, 202, 245)
    check_color = rgb(224, 175, 104)
    fail_color = rgb(247, 118, 141)
    fade_on_empty = false
    placeholder_text = 请输入密码...
    hide_input = false
    position = 0, -50
    # shadow_passes = 3           
    # shadow_size = 5             
    # shadow_color = rgba(26, 27, 38, 0.8)
    halign = center
    valign = center
}
